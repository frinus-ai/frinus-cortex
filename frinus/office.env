# office.env — perfil de segurança "local-cliente" do Frinus Office (POC).
# Carregado por frinus/bin/frinus-office. Mantém o escritório preso ao próprio
# computador (loopback), sem World, sem auto-update e sem acesso remoto.

# --- Rede: só o próprio computador ---
HABBLAUD_HOST=127.0.0.1
HABBLAUD_PORT=4748

# --- Recursos ligados/desligados ---
# PTY=1: liga o "Novo agente" e a janela/terminal do agente embutida (só vale com bind local).
HABBLAUD_PTY=1
# World desligado: nada sai do computador.
HABBLAUD_WORLD=0
# Sem checagem de versão nova no GitHub.
HABBLAUD_UPDATE_CHECK=0
# Codex desligado: o cliente Frinus usa só o Claude Code (senão o ~/.codex aparece como conta).
HABBLAUD_CODEX=0

# Sem HABBLAUD_REMOTE_* (segunda porta com login para celular): deixado em branco de propósito.

# --- Lançador Frinus ---
# Todo "Novo agente" nasce como o orquestrador frinus com memória (ver frinus/bin/frinus-claude).
# Caminho resolvido em tempo de execução por frinus-office (HABBLAUD_CLAUDE_BIN).

# Conta/pasta de config do Claude Code do cliente: só esta é observada pelo escritório,
# e é a que o frinus-claude usa (exporta CLAUDE_CONFIG_DIR a partir dela).
HABBLAUD_CLAUDE_DIRS=/home/renato/.claude-rdx
FRINUS_OFFICE_CLAUDE_DIR=/home/renato/.claude-rdx

# --- Estado do próprio escritório, separado do Habblaud de produção (~/.habblaud) ---
HABBLAUD_DATA_DIR=/home/renato/.frinus-office
HABBLAUD_USAGE_DIR=/home/renato/.frinus-office/usage
