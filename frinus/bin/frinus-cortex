#!/usr/bin/env bash
# frinus-cortex — sobe o Frinus Córtex (fork do Habblaud) no perfil local-cliente.
#
# Carrega frinus/cortex.env, aponta o lançador Frinus (HABBLAUD_CLAUDE_BIN) e roda o
# servidor já compilado (dist/server/index.js). A release já vem compilada; numa cópia
# do código-fonte, rode `npm run build` antes, uma vez.
set -euo pipefail

# Raiz do Córtex, a partir deste script em frinus/bin/.
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/../.." && pwd)"

# node/claude no PATH (o serviço não lê o ~/.bashrc).
# shellcheck disable=SC1091
. "$here/lib.sh"
frinus_load_node

# Perfil local-cliente. cortex.env é o nome atual; office.env fica como atalho de compatibilidade (remover na 0.3.0).
set -a
# shellcheck disable=SC1091
if [ -f "$root/frinus/cortex.env" ]; then . "$root/frinus/cortex.env"; else . "$root/frinus/office.env"; fi
set +a

# Estado do Córtex separado do Habblaud de produção (~/.habblaud). Pasta nova ~/.frinus-cortex;
# cai na antiga ~/.frinus-office só se ela existir e a nova ainda não (cliente pré-migração).
if [ -z "${HABBLAUD_DATA_DIR:-}" ] && [ ! -d "$HOME/.frinus-cortex" ] && [ -d "$HOME/.frinus-office" ]; then
  export HABBLAUD_DATA_DIR="$HOME/.frinus-office"
else
  export HABBLAUD_DATA_DIR="${HABBLAUD_DATA_DIR:-$HOME/.frinus-cortex}"
fi

# Lançador Frinus (caminho absoluto; o wrapper precede `--agent frinus`).
export HABBLAUD_CLAUDE_BIN="$here/frinus-claude"

# Garante os diretórios de estado e a pasta de trabalho padrão do cliente.
mkdir -p "$HABBLAUD_DATA_DIR" "$HOME/Frinus"

if [ ! -f "$root/dist/server/index.js" ]; then
  echo "frinus-cortex: build ausente. Rode 'npm run build' em $root primeiro." >&2
  exit 1
fi
if ! frinus_node_ok; then
  echo "frinus-cortex: precisa do Node 22.12 ou mais novo. Rode o instalador do Frinus Córtex de novo." >&2
  exit 1
fi

exec node "$root/dist/server/index.js" "$@"
